{
  "name": "WorkshopUpgrade",
  "type": "object",
  "properties": {
    "servant_id": {
      "type": "string",
      "description": "Which servant's workshop this belongs to"
    },
    "upgrade_type": {
      "type": "string",
      "enum": [
        "quality_tools",
        "speed_bench",
        "rare_materials",
        "display_case",
        "marketing"
      ],
      "description": "Type of upgrade"
    },
    "level": {
      "type": "number",
      "default": 1,
      "description": "Upgrade level (1-3)"
    },
    "cost": {
      "type": "number",
      "description": "Cost to purchase this upgrade"
    }
  },
  "required": [
    "servant_id",
    "upgrade_type"
  ]
}