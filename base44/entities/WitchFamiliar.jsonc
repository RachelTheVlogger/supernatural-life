{
  "name": "WitchFamiliar",
  "type": "object",
  "properties": {
    "witch_id": {
      "type": "string",
      "description": "Which witch owns this familiar"
    },
    "name": {
      "type": "string",
      "description": "Familiar's name/type"
    },
    "type": {
      "type": "string",
      "enum": [
        "cat",
        "raven",
        "owl",
        "serpent"
      ],
      "description": "Type of familiar"
    },
    "bond_level": {
      "type": "number",
      "default": 15,
      "description": "Bond with witch (0-100)"
    },
    "magic_power": {
      "type": "number",
      "default": 25,
      "description": "Familiar's magic power (0-100)"
    },
    "loyalty": {
      "type": "number",
      "default": 60,
      "description": "Loyalty to witch (0-100)"
    },
    "missions_completed": {
      "type": "number",
      "default": 0,
      "description": "Number of missions completed"
    }
  },
  "required": [
    "witch_id",
    "name",
    "type"
  ]
}