{
  "name": "PowerProgress",
  "type": "object",
  "properties": {
    "power_name": {
      "type": "string",
      "description": "Name of the power"
    },
    "times_used": {
      "type": "number",
      "default": 0,
      "description": "Number of times this power has been used"
    },
    "upgrade_level": {
      "type": "number",
      "default": 1,
      "description": "Current upgrade level (1-3)"
    },
    "mastery": {
      "type": "number",
      "default": 0,
      "description": "Mastery percentage (0-100)"
    }
  },
  "required": [
    "power_name"
  ]
}