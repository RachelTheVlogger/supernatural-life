{
  "name": "CovenMember",
  "type": "object",
  "properties": {
    "vampire_id": {
      "type": "string",
      "description": "Reference to vampire (could be turned servant or recruited vampire)"
    },
    "role": {
      "type": "string",
      "enum": [
        "lieutenant",
        "enforcer",
        "recruiter",
        "advisor"
      ],
      "description": "Role in your coven"
    },
    "loyalty": {
      "type": "number",
      "default": 50,
      "description": "Loyalty to you (0-100)"
    },
    "power_contribution": {
      "type": "number",
      "default": 0,
      "description": "Power they add to coven"
    }
  },
  "required": [
    "vampire_id",
    "role"
  ]
}